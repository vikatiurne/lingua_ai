{
  "name": "lingua-ai",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:cms": "pnpm --filter cms develop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "seed": "pnpm --filter @lingua/scripts seed",
    "generate:rules": "tsx scripts/generate-rules.ts",
    "translate:rules": "tsx scripts/translate-rules.ts",
    "fix:formulas": "tsx scripts/fix-formulas.ts",
    "cleanup:reviews": "tsx --env-file=apps/web/.env apps/web/scripts/cleanup-review-duplicates.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
